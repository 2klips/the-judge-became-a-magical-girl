{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nhn-voice-mvp-worker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-02",
  "workers_dev": false,
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173",
    "OPENAI_TRANSCRIBE_MODEL": "gpt-transcribe",
    "OPENAI_REALTIME_MODEL": "gpt-realtime-2.1-mini",
    "ENABLE_OPENAI_STT_MODEL_SELECTOR": "true",
    "GEMINI_TRANSCRIBE_MODEL": "gemini-2.5-flash",
    "LLM_PROVIDER": "gemini",
    "GEMINI_LLM_MODEL": "gemini-3.1-flash-lite"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY", "GEMINI_API_KEY"]
  },
  "env": {
    "qa": {
      "name": "nhn-voice-m5-qa-worker",
      "workers_dev": true,
      "placement": {
        "region": "aws:us-east-1"
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://2klips.github.io",
        "OPENAI_TRANSCRIBE_MODEL": "gpt-transcribe",
        "OPENAI_REALTIME_MODEL": "gpt-realtime-2.1-mini",
        "ENABLE_OPENAI_STT_MODEL_SELECTOR": "true",
        "GEMINI_TRANSCRIBE_MODEL": "gemini-2.5-flash",
        "LLM_PROVIDER": "openai",
        "OPENAI_LLM_MODEL": "gpt-5.6-luna",
        "GEMINI_LLM_MODEL": "gemini-3.1-flash-lite"
      },
      "secrets": {
        "required": ["OPENAI_API_KEY"]
      }
    }
  }
}
