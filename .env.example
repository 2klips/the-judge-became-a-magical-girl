# 로컬 M3 Worker와 STT 비교 Lab 전용. 실제 키는 .env.local에만 저장합니다.
OPENAI_API_KEY=replace_with_openai_api_key
GEMINI_API_KEY=replace_with_gemini_api_key

# 공개 QA·production 게임 STT는 GPT로 고정합니다. Gemini 키는 대화·전투 LLM용입니다.
# 아래 Gemini STT 모델은 격리된 로컬 비교 Lab에만 사용합니다.
# 선택값: 비워 두면 wrangler.jsonc 기본 모델을 사용합니다.
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
# GEMINI_LLM_MODEL=gemini-3.1-flash-lite

# 정적 클라이언트에는 키를 넣지 않습니다.
VITE_WORKER_URL=http://127.0.0.1:8787
